{
  "name": "ozor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-workflow-manual.mjs && tsc -b && vite build",
    "manual:build": "node scripts/build-workflow-manual.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:menu-ai": "node --test scripts/test-menu-ai.mjs",
    "test:picture-menu": "node --test scripts/test-picture-menu.mjs",
    "test:auth": "node --test scripts/test-auth.mjs",
    "test:clients": "npm --prefix backend run build && node --test backend/dist/controllers/clientController.test.js",
    "test:clients:integration": "npm --prefix backend run build && node --test backend/dist/controllers/clientController.integration.test.js",
    "test:permissions": "npm --prefix backend run build && node --test scripts/test-screen-permissions.mjs backend/dist/utils/digitalMenuAccess.test.js",
    "test:api-url": "node --test scripts/test-api-url.mjs",
    "test:client-locations": "node --test scripts/test-client-locations.mjs",
    "test:organization": "npm --prefix backend run build && node --test backend/dist/controllers/organizationController.test.js",
    "test:organization:integration": "npm --prefix backend run build && node --test backend/dist/controllers/organizationController.integration.test.js",
    "test:inventory-requests": "npm --prefix backend run build && node --test scripts/test-inventory-requests.mjs backend/dist/controllers/inventoryRequestController.test.js backend/dist/controllers/inventoryVendorController.test.js",
    "test:branches": "npm --prefix backend run build && node --test backend/dist/utils/branchScope.integration.test.js"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@reduxjs/toolkit": "^2.11.2",
    "@vladmandic/face-api": "^1.7.15",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "redux-persist": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
